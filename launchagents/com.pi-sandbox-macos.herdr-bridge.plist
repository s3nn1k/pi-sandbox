<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pi-sandbox-macos.herdr-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/pi-sandbox-macos/bin/herdr-sock-bridge</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/pi-sandbox-macos/herdr-bridge.out</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/pi-sandbox-macos/herdr-bridge.err</string>
</dict>
</plist>
