#!/usr/bin/env bash
set -uo pipefail
SBX="$HOME/pi-sandbox"

if [[ "${1:-}" == "--unsafe" ]]; then
  shift
  exec command pi "$@"
fi

case "${1:-}" in
  update|mcp|auth|install|remove|uninstall|list|config)
    exec command pi "$@"
    ;;
esac

under_launch_root() {
  local path="$1" p
  while IFS= read -r p; do
    [[ "$p" == *vm-only* || "$p" == *root-only* ]] && continue
    [[ "$path" == "$HOME/$p" || "$path" == "$HOME/$p"/* ]] && return 0
  done < <(grep -vE '^\s*#|^\s*$' "$SBX/pi-mounts")
  return 1
}

session_path=""
cli_args=("$@")
for ((i = 0; i < ${#cli_args[@]}; i++)); do
  case "${cli_args[i]}" in
    --session) (( i + 1 < ${#cli_args[@]} )) && session_path="${cli_args[i + 1]}" ;;
    --session=*) session_path="${cli_args[i]#--session=}" ;;
  esac
  [[ -n "$session_path" ]] && break
done
if [[ -n "$session_path" && -r "$session_path" ]]; then
  session_root="$(head -n 1 "$session_path" | jq -r 'select(.type == "session") | .cwd // empty' 2>/dev/null)"
  if [[ -n "$session_root" ]] && ! under_launch_root "$session_root"; then
    echo "pi: сессия создана вне песочницы (cwd $session_root) — возобновляю хостовым pi" >&2
    exec command pi "$@"
  fi
fi

PWD="$(pwd -P)"
if under_launch_root "$PWD"; then
  if [[ "$PWD" == *..* ]]; then
    echo "pi: '$PWD' содержит '..' — запуск из канонического пути" >&2
    exit 1
  fi
else
  echo "pi: '$PWD' вне корней песочницы — запускаю хостовым pi" >&2
  exec command pi "$@"
fi

unset DOCKER_HOST

AGENT_UID="$(id -u)"
AGENT_GID="$(id -g)"
export AGENT_HOME="$HOME" AGENT_UID AGENT_GID WORKDIR="$PWD"

DIND_ID="$("$SBX/launch/steps/preflight.sh")" || exit 1
[[ "$DIND_ID" =~ ^[0-9a-f]{12,64}$ ]] || { echo "pi: dind-id не распознан" >&2; exit 1; }
export DIND_ID
"$SBX/launch/steps/sync.sh" || exit 1
exec "$SBX/launch/steps/session.sh" "$@"
